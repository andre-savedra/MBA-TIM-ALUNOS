{
  "openapi": "3.0.3",
  "info": {
    "title": "Exchange simulado • Laboratório SENAI",
    "version": "1.1.0",
    "description": "Dados sintéticos. Recorte de leitura da Aula 1 baseado no PDF Exchange v3.6.10, impresso em 31/10/2026. Não é Swagger oficial WEG e NÃO comprova compatibilidade total. As rotas abaixo são realmente implementadas no simulador. Consulte CONTRATO.md para diferenças. Endpoints comerciais fora desse recorte retornam 501 e não são oferecidos aqui como implementados. Uso: execute POST /exchange/auth; copie token; clique Authorize e cole somente o token, sem escrever Bearer. Todas as chamadas permanecem neste servidor local."
  },
  "servers": [
    {
      "url": "/",
      "description": "Somente o simulador local em que esta página está aberta"
    }
  ],
  "tags": [
    {
      "name": "1. Autenticação"
    },
    {
      "name": "2. Hierarquia"
    },
    {
      "name": "3. Ativo"
    },
    {
      "name": "4. Medições"
    },
    {
      "name": "5. Somente simulador"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/exchange/auth": {
      "post": {
        "tags": [
          "1. Autenticação"
        ],
        "summary": "Obter token fictício",
        "description": "Credenciais do laboratório. Token válido por 24h; reinício/invalidação local também o revoga. PDF WEG pp. 7–8, 47. Copie somente o valor de token e cole em Authorize.",
        "operationId": "post__exchange_auth",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "401": {
            "description": "Comportamento descrito no contrato do simulador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        }
      }
    },
    "/exchange/customers/sites": {
      "get": {
        "tags": [
          "2. Hierarquia"
        ],
        "summary": "Listar unidades",
        "description": "Campos conforme exemplo do PDF pp. 8–9; valores sintéticos.",
        "operationId": "get__exchange_customers_sites",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Site"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido, revogado ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/exchange/sites/{siteId}/plants": {
      "get": {
        "tags": [
          "2. Hierarquia"
        ],
        "summary": "Listar plantas",
        "description": "PDF pp. 9–10.",
        "operationId": "get__exchange_sites_siteId_plants",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Plant"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido, revogado ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Comportamento descrito no contrato do simulador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Comportamento descrito no contrato do simulador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "siteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "100000000000000000000001",
              "pattern": "^[0-9a-f]{24}$"
            }
          }
        ]
      }
    },
    "/exchange/plants/{plantId}/devices": {
      "get": {
        "tags": [
          "2. Hierarquia"
        ],
        "summary": "Listar ativos com paginação",
        "description": "page começa em zero. Padrões do contrato: page=0 e perPage=500. Try it out sugere perPage=1 para exercitar duas páginas. 204 sem itens; máximo 500 é limite didático.",
        "operationId": "get__exchange_plants_plantId_devices",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevicePage"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido, revogado ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "204": {
            "description": "Comportamento descrito no contrato do simulador"
          },
          "400": {
            "description": "Comportamento descrito no contrato do simulador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Comportamento descrito no contrato do simulador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "plantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "200000000000000000000001",
              "pattern": "^[0-9a-f]{24}$"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 500
            },
            "example": 1
          }
        ]
      }
    },
    "/exchange/devices/{deviceId}": {
      "get": {
        "tags": [
          "3. Ativo"
        ],
        "summary": "Consultar ativo",
        "description": "PDF pp. 11–12: subconjunto dos campos do dispositivo, não objeto completo de toda recipe WEG.",
        "operationId": "get__exchange_devices_deviceId",
        "responses": {
          "200": {

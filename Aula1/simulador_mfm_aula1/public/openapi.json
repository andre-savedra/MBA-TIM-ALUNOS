          "400": {
            "description": "Comportamento descrito no contrato do simulador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Scenario"
              }
            }
          }
        }
      }
    },
    "/__sim/expire-tokens": {
      "post": {
        "tags": [
          "5. Somente simulador"
        ],
        "summary": "Invalidar tokens locais",
        "description": "Não existe no Exchange WEG. Após executar, use novamente POST /auth e atualize Authorize.",
        "operationId": "post____sim_expire_tokens",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "example": "Unauthorized"
              },
              "type": {
                "type": "string",
                "example": "Unauthorized"
              }
            },
            "required": [
              "message",
              "type"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Credentials": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "aluno@simulador.local"
          },
          "password": {
            "type": "string",
            "example": "senai-aula1",
            "format": "password"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "Token": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "JWT_FICTICIO_RETORNADO_PELO_LOGIN"
          }
        },
        "required": [
          "token"
        ]
      },
      "Site": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string",
            "example": "100000000000000000000001"
          },
          "name": {
            "type": "string",
            "example": "SENAI_DEMO"
          },
          "description": {
            "type": "string",
            "example": "Unidade fictícia"
          }
        },
        "required": [
          "siteId",
          "name",
          "description"
        ]
      },
      "Plant": {
        "type": "object",
        "properties": {
          "plantId": {
            "type": "string",
            "example": "200000000000000000000001"
          },
          "name": {
            "type": "string",
            "example": "Bancada_DEMO"
          },
          "description": {
            "type": "string"
          },
          "geolocation": {
            "type": "string",
            "example": "-22.90,-47.06"
          }
        },
        "required": [
          "plantId",
          "name",
          "description",
          "geolocation"
        ]
      },
      "Device": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "example": "300000000000000000000001",
            "pattern": "^[0-9a-f]{24}$"
          },
          "name": {
            "type": "string",
            "example": "Motor_01"
          },
          "description": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "example": "200000000000000000000001"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "connectionInfo": {
            "type": "object",
            "properties": {
              "connected": {
                "type": "boolean"
              }
            }
          }
        },
        "required": [
          "deviceId",
          "name",
          "parentId"
        ]
      },
      "DevicePage": {
        "type": "object",
        "properties": {
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Device"
            }
          },
          "page": {
            "type": "integer",
            "example": 0
          },
          "perPage": {
            "type": "integer",
            "example": 1
          }
        },
        "required": [
          "devices",
          "page",
          "perPage"
        ]
      },
      "SensorDidatico": {
        "type": "object",
        "properties": {
          "sensorId": {
            "type": "string",
            "example": "400000000000000000000001"
          },
          "deviceId": {
            "type": "string",
            "example": "300000000000000000000001",
            "pattern": "^[0-9a-f]{24}$"
          },
          "name": {
            "type": "string",
            "example": "MotorScan_DEMO_01"
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "sensorId",
          "deviceId",
          "name",
          "attributes"
        ]
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "500000000000000000000001"
          },
          "deviceId": {
            "type": "string",
            "example": "300000000000000000000001",
            "pattern": "^[0-9a-f]{24}$"
          },
          "subject": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "creationDate": {
            "type": "string",
            "format": "date-time"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          },
          "updates": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "level": {
            "type": "string",
            "example": "warning"
          },
          "state": {
            "type": "string",
            "example": "new"
          },
          "deviceName": {
            "type": "string",
            "example": "Motor_01"
          }
        }
      },
      "SeriesDidatica": {
        "type": "object",
        "properties": {
          "sensorId": {
            "type": "string",
            "example": "400000000000000000000001"
          },
          "deviceId": {
            "type": "string",
            "example": "300000000000000000000001",
            "pattern": "^[0-9a-f]{24}$"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "timestamp": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2026-10-31T12:00:00.000Z"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "surfaceTemperature": {
                      "type": "number",
                      "nullable": true,
                      "example": 41
                    },
                    "velX": {
                      "type": "number",
                      "example": 2.2
                    },
                    "velY": {
                      "type": "number",
                      "example": 1.8
                    },
                    "velZ": {
                      "type": "number",
                      "example": 2.1
                    },
                    "speed": {
                      "type": "number",
                      "example": 1780
                    }
                  }
                }
              },
              "required": [
                "timestamp",
                "data"
              ]
            }
          }
        },
        "required": [

    "/exchange/sensors/{sensorId}/data": {
      "get": {
        "tags": [
          "4. Medições"
        ],
        "summary": "Consultar série — envelope didático",
        "description": "Rota e filtros: PDF pp. 19–20, 48. O PDF NÃO especifica o JSON completo de retorno. Este envelope é didático. Datas sintéticas fixas em 31/10/2026; fronteiras inclusivas locais. Nome/unidade dos atributos: pp. 37–42.",
        "operationId": "get__exchange_sensors_sensorId_data",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeriesDidatica"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido, revogado ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Comportamento descrito no contrato do simulador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Comportamento descrito no contrato do simulador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Comportamento descrito no contrato do simulador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Segundos a aguardar no cenário local",
                "schema": {
                  "type": "string",
                  "example": "60"
                }
              }
            }
          },
          "500": {
            "description": "Comportamento descrito no contrato do simulador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "sensorId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "400000000000000000000001",
              "pattern": "^[0-9a-f]{24}$"
            }
          },
          {
            "name": "initial_timestamp",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-10-31T12:00:00.000Z"
          },
          {
            "name": "final_timestamp",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-10-31T14:00:00.000Z"
          }
        ]
      }
    },
    "/__sim/status": {
      "get": {
        "tags": [
          "5. Somente simulador"
        ],
        "summary": "Consultar cenário e período",
        "description": "Não existe no Exchange WEG.",
        "operationId": "get____sim_status",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/__sim/scenario": {
      "post": {
        "tags": [
          "5. Somente simulador"
        ],
        "summary": "Mudar cenário",
        "description": "Não existe no Exchange WEG. Altera o cenário da próxima consulta para todos os clientes locais; não publica dados automaticamente.",
        "operationId": "post____sim_scenario",
        "responses": {
          "200": {

      "get": {
        "tags": [
          "3. Ativo"
        ],
        "summary": "Listar eventos",
        "description": "Campos do exemplo da p. 13; evento fictício fixo, não recalculado por cenário.",
        "operationId": "get__exchange_devices_deviceId_events",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Event"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido, revogado ou expirado",

          }
        },
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "300000000000000000000001",
              "pattern": "^[0-9a-f]{24}$"
            }
          }
        ]
      }
    },

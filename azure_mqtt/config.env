# =====================================================================
#  TIM_2026 - configuracao do laboratorio MQTT na Azure
#  Edite este arquivo; os scripts leem daqui. Nao use aspas nos valores.
#  Vale para macOS, Linux e Windows.
# =====================================================================

# --- Regiao -----------------------------------------------------------
# Regiao preferida. Ver as disponiveis: az account list-locations -o table
REGIAO=westus3

# Regioes tentadas em ordem, caso a preferida esteja sem capacidade ou cota.
# Isso acontece com frequencia quando a turma inteira cria ao mesmo tempo.
# Deixe vazio para nao tentar nenhuma alternativa.
REGIOES_ALTERNATIVAS=brazilsoutheast,eastus2,eastus,westus3

# --- Tamanho da VM ----------------------------------------------------
# O broker e leve: o menor tamanho basta. Precos de referencia por mes,
# com a VM ligada 24h (consulte o calculador oficial para a sua assinatura):
#   Standard_B1ls   1 vCPU / 0,5 GB  ~ US$  4   (mais barato)
#   Standard_B1s    1 vCPU / 1,0 GB  ~ US$  8   (padrao, folga confortavel)
#   Standard_B2ts_v2 2 vCPU / 1,0 GB ~ US$  9
# Os scripts recusam tamanhos fora da lista de economicos, para evitar
# gasto acidental com a assinatura da turma.
TAMANHO_VM=Standard_B1s

# Tamanhos tentados em ordem, caso o preferido falte na regiao.
TAMANHOS_ALTERNATIVOS=Standard_B1ls,Standard_B2ts_v2

# --- Rede -------------------------------------------------------------
# Origem autorizada nas regras de entrada. Internet = qualquer origem,
# protegida por usuario, senha e ACL. Recomendado: IP publico de saida
# do SENAI em CIDR, por exemplo 200.1.2.3/32
ORIGEM=Internet

# Abrir tambem a porta 1883 (MQTT/TCP). A pratica usa WebSocket na 80;
# isso serve apenas para testes em redes sem bloqueio. true ou false.
ABRIR_1883=true

# --- Nomes ------------------------------------------------------------
# Prefixo do grupo de recursos. O nome final fica <prefixo>-<equipe>.
PREFIXO_GRUPO=mqtt-lab-rg
